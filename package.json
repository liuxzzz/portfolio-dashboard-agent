{
  "name": "portfolio-dashboard-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Private portfolio snapshot collector and responsive dashboard.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.23.6",
    "typescript": "7.0.2"
  }
}

