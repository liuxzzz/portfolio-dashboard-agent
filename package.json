{
  "name": "portfolio-dashboard-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Native Android portfolio client, private collector and evidence-first Agent backend.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "pnpm --filter @portfolio/api run prisma:generate",
    "dev": "pnpm --filter @portfolio/api dev",
    "dev:android": "bash scripts/dev-android.sh",
    "dev:web": "pnpm --filter @portfolio/web dev",
    "build": "pnpm -r --if-present build",
    "android:assemble": "cd apps/android && ./gradlew assembleDebug",
    "android:test": "cd apps/android && ./gradlew testDebugUnitTest",
    "android:lint": "cd apps/android && ./gradlew lintDebug",
    "android:reverse": "adb reverse tcp:4000 tcp:4000",
    "android:install": "cd apps/android && ./gradlew installDebug",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @portfolio/api run prisma:generate",
    "db:migrate": "pnpm --filter @portfolio/api run db:migrate",
    "db:deploy": "pnpm --filter @portfolio/api run db:deploy",
    "db:status": "pnpm --filter @portfolio/api run db:status",
    "db:studio": "pnpm --filter @portfolio/api run db:studio"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.23.6",
    "typescript": "7.0.2"
  }
}
