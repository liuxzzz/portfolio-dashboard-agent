NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://portfolio:portfolio@127.0.0.1:5433/portfolio?schema=public
# Native Android requests do not use CORS. This is only for local browser API tooling.
CLIENT_ORIGIN=http://localhost:8081

# Generate unique values locally. Never commit real secrets.
INGEST_SHARED_SECRET=replace-with-a-random-secret
AUTH_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-a-32-byte-key

# Alibaba Cloud Phone Number Verification Service / SMS Authentication.
ALIBABA_CLOUD_ACCESS_KEY_ID=replace-with-ram-user-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=replace-with-ram-user-access-key-secret
ALIYUN_PNVS_SIGN_NAME=replace-with-current-system-provided-sign-name
ALIYUN_PNVS_TEMPLATE_CODE=100001

# Free server-side market data enrichment. Choices: eastmoney, tushare, disabled.
INDUSTRY_PROVIDER=eastmoney
# Optional paid fallback. Only required when INDUSTRY_PROVIDER=tushare.
TUSHARE_TOKEN=
TUSHARE_API_URL=https://api.tushare.pro

# Local collector. The browser profile path remains ignored by Git.
TZZB_BASE_URL=https://tzzb.10jqka.com.cn
TZZB_PROFILE_DIR=browser-profile/tzzb
TZZB_BROWSER_CHANNEL=chrome
# Optional override when Google Chrome is installed in a custom location.
TZZB_CHROME_EXECUTABLE=
TZZB_HEADLESS=true
TZZB_RATE_UNIT=percent
# Optional: attach to a user-opened isolated Chrome on localhost.
TZZB_CDP_URL=

# Optional local-only filters. Never commit real values.
TZZB_ACCOUNT_IDS=
TZZB_USER_ID=

# Collector upload destination. Keep local until read-side authentication lands.
PORTFOLIO_API_URL=http://127.0.0.1:4000
# The user must log in to the Android app once before their first upload.
PORTFOLIO_USER_PHONE=13800138000
