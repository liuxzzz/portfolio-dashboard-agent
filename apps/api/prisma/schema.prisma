generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DataFreshness {
  fresh
  stale
  unknown
}

enum AgentRunStatus {
  queued
  running
  completed
  failed
}

enum InsightSeverity {
  info
  attention
  risk
}

enum InsightCategory {
  freshness
  concentration
  cash
  change
  note
}

enum EvidenceKind {
  snapshot
  position
  calculation
  market
}

model User {
  id                String                @id @default(cuid())
  phone             String?               @unique @db.VarChar(32)
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  accounts          Account[]
  sessions          AuthSession[]
  verificationCodes SmsVerificationCode[]
  industryTags      IndustryTag[]

  @@map("users")
}

model SmsVerificationCode {
  id         String    @id @db.VarChar(64)
  userId     String?
  phone      String    @db.VarChar(32)
  codeHash   String    @db.VarChar(64)
  attempts   Int       @default(0)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("sms_verification_codes")
}

model AuthSession {
  id         String    @id @db.VarChar(64)
  userId     String
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt(sort: Desc)])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Account {
  id                     String                          @id @default(cuid())
  userId                 String
  source                 String                          @db.VarChar(32)
  sourceAccountId        String                          @db.VarChar(255)
  name                   String                          @db.VarChar(255)
  currency               String                          @default("CNY") @db.VarChar(16)
  createdAt              DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                        @updatedAt @db.Timestamptz(3)
  user                   User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  snapshots              Snapshot[]
  industryTagAssignments SecurityIndustryTagAssignment[]

  @@unique([userId, source, sourceAccountId])
  @@index([userId, updatedAt])
  @@index([updatedAt])
  @@map("accounts")
}

model Snapshot {
  id                    String        @id @db.VarChar(255)
  externalId            String        @db.VarChar(255)
  accountId             String
  schemaVersion         Int           @default(1)
  sourceContractVersion String        @default("tzzb-v1") @db.VarChar(64)
  calculationVersion    String        @default("1") @db.VarChar(32)
  contentHash           String        @db.VarChar(64)
  capturedAt            DateTime      @db.Timestamptz(3)
  sourceSyncedAt        DateTime?     @db.Timestamptz(3)
  freshness             DataFreshness
  currency              String        @default("CNY") @db.VarChar(16)
  totalAsset            Decimal       @db.Decimal(24, 8)
  cash                  Decimal       @db.Decimal(24, 8)
  stockMarketValue      Decimal       @db.Decimal(24, 8)
  dayProfit             Decimal?      @db.Decimal(24, 8)
  dayProfitRate         Decimal?      @db.Decimal(20, 12)
  positionRate          Decimal?      @db.Decimal(20, 12)
  ingestedAt            DateTime      @default(now()) @db.Timestamptz(3)
  account               Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  positions             Position[]
  agentRuns             AgentRun[]

  @@unique([accountId, externalId])
  @@unique([accountId, capturedAt])
  @@index([accountId, capturedAt(sort: Desc)])
  @@index([capturedAt(sort: Desc)])
  @@map("snapshots")
}

model Position {
  id                   String   @id @db.VarChar(512)
  snapshotId           String
  symbol               String   @db.VarChar(64)
  name                 String   @db.VarChar(255)
  market               String   @db.VarChar(32)
  industry             String?  @db.VarChar(255)
  quantity             Decimal  @db.Decimal(24, 8)
  currentPrice         Decimal? @db.Decimal(24, 8)
  unitCost             Decimal? @db.Decimal(24, 8)
  marketValue          Decimal  @db.Decimal(24, 8)
  portfolioWeight      Decimal? @db.Decimal(20, 12)
  dayProfit            Decimal? @db.Decimal(24, 8)
  dayProfitRate        Decimal? @db.Decimal(20, 12)
  holdingProfit        Decimal? @db.Decimal(24, 8)
  holdingProfitRate    Decimal? @db.Decimal(20, 12)
  holdingDays          Int?
  latestRate           Decimal? @db.Decimal(20, 12)
  relatedSector        String?  @db.VarChar(255)
  sectorRate           Decimal? @db.Decimal(20, 12)
  combinationProfit    Decimal? @db.Decimal(24, 8)
  combinationRate      Decimal? @db.Decimal(20, 12)
  cumulativeProfit     Decimal? @db.Decimal(24, 8)
  cumulativeProfitRate Decimal? @db.Decimal(20, 12)
  weekProfit           Decimal? @db.Decimal(24, 8)
  monthProfit          Decimal? @db.Decimal(24, 8)
  yearProfit           Decimal? @db.Decimal(24, 8)
  breakEvenRate        Decimal? @db.Decimal(20, 12)
  oneMonthRate         Decimal? @db.Decimal(20, 12)
  threeMonthRate       Decimal? @db.Decimal(20, 12)
  sixMonthRate         Decimal? @db.Decimal(20, 12)
  oneYearRate          Decimal? @db.Decimal(20, 12)
  snapshot             Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, market, symbol])
  @@index([snapshotId, marketValue(sort: Desc)])
  @@index([symbol])
  @@map("positions")
}

model SecurityIndustryMembership {
  id            String    @id @db.VarChar(64)
  taxonomy      String    @db.VarChar(32)
  market        String    @db.VarChar(32)
  symbol        String    @db.VarChar(64)
  level1Code    String    @db.VarChar(32)
  level1Name    String    @db.VarChar(255)
  level2Code    String?   @db.VarChar(32)
  level2Name    String?   @db.VarChar(255)
  level3Code    String?   @db.VarChar(32)
  level3Name    String?   @db.VarChar(255)
  effectiveFrom DateTime? @db.Timestamptz(3)
  effectiveTo   DateTime? @db.Timestamptz(3)
  isCurrent     Boolean   @default(false)
  source        String    @db.VarChar(64)
  fetchedAt     DateTime  @db.Timestamptz(3)

  @@index([taxonomy, market, symbol, effectiveFrom(sort: Desc)])
  @@index([taxonomy, level1Code, isCurrent])
  @@map("security_industry_memberships")
}

model IndustryMarketBar {
  id           String   @id @db.VarChar(64)
  taxonomy     String   @db.VarChar(32)
  industryCode String   @db.VarChar(32)
  industryName String   @db.VarChar(255)
  tradeDate    DateTime @db.Timestamptz(3)
  close        Decimal? @db.Decimal(24, 8)
  pctChange    Decimal? @db.Decimal(20, 12)
  source       String   @db.VarChar(64)
  fetchedAt    DateTime @db.Timestamptz(3)

  @@unique([taxonomy, industryCode, tradeDate])
  @@index([taxonomy, industryCode, tradeDate(sort: Desc)])
  @@map("industry_market_bars")
}

model IndustryTag {
  id          String                          @id @default(cuid())
  userId      String
  name        String                          @db.VarChar(64)
  color       String                          @db.VarChar(16)
  sortOrder   Int
  createdAt   DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                        @updatedAt @db.Timestamptz(3)
  user        User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments SecurityIndustryTagAssignment[]

  @@unique([userId, name])
  @@index([userId, sortOrder])
  @@map("industry_tags")
}

model SecurityIndustryTagAssignment {
  id        String      @id @default(cuid())
  accountId String
  market    String      @db.VarChar(32)
  symbol    String      @db.VarChar(64)
  tagId     String
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tag       IndustryTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([accountId, market, symbol])
  @@index([tagId])
  @@map("security_industry_overrides")
}

model AgentRun {
  id          String         @id @db.VarChar(512)
  externalId  String         @db.VarChar(512)
  snapshotId  String
  status      AgentRunStatus
  requestedAt DateTime       @db.Timestamptz(3)
  completedAt DateTime?      @db.Timestamptz(3)
  model       String?        @db.VarChar(255)
  disclaimer  String         @db.Text
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  snapshot    Snapshot       @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  insights    AgentInsight[]

  @@unique([snapshotId, externalId])
  @@index([snapshotId, requestedAt(sort: Desc)])
  @@map("agent_runs")
}

model AgentInsight {
  id              String          @id @db.VarChar(768)
  runId           String
  sourceInsightId String          @db.VarChar(512)
  category        InsightCategory
  severity        InsightSeverity
  title           String          @db.VarChar(255)
  summary         String          @db.Text
  confidence      Decimal         @db.Decimal(5, 4)
  createdAt       DateTime        @db.Timestamptz(3)
  run             AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  evidence        AgentEvidence[]

  @@unique([runId, sourceInsightId])
  @@index([runId])
  @@map("agent_insights")
}

model AgentEvidence {
  id          String       @id @db.VarChar(768)
  insightId   String
  kind        EvidenceKind
  referenceId String       @db.VarChar(512)
  label       String       @db.VarChar(512)
  asOf        DateTime     @db.Timestamptz(3)
  insight     AgentInsight @relation(fields: [insightId], references: [id], onDelete: Cascade)

  @@index([insightId])
  @@index([referenceId])
  @@map("agent_evidence")
}
