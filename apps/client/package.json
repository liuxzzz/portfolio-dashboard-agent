    "@tanstack/react-query": "5.101.4",
    "expo": "57.0.10",
    "expo-constants": "57.0.9",
    "expo-linking": "57.0.5",
    "expo-router": "57.0.10",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2"
  },
